{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun test*)",
      "Bash(bun run dev*)",
      "Bash(bun run check)",
      "Bash(bun run fix)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run knip)",
      "Bash(bun run drizzle:*)",
      "Bash(bunx tsc --noEmit*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited.sh\""
          }
        ]
      }
    ]
  }
}
