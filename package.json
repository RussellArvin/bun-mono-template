{
  "name": "bun-mono-template",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bun run --filter '*' build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/app",
    "drizzle:generate": "bun run --filter '@repo/database' drizzle:generate",
    "drizzle:migrate": "bun run --filter '@repo/database' drizzle:migrate",
    "drizzle:migrate:test": "DATABASE_URL=postgresql://user:pass@localhost:5432/app_test bun run --filter '@repo/database' drizzle:migrate",
    "drizzle:push": "bun run --filter '@repo/database' drizzle:push",
    "drizzle:studio": "bun run --filter '@repo/database' drizzle:studio",
    "test": "bun test packages/server",
    "test:e2e": "bun run --filter '@repo/e2e' test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.8.2",
    "typescript": "^7.0.2"
  }
}
