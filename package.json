{
  "name": "bun-mono-template",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run check:workspace && bun run check:docs && bun run check:env && prettier --check .",
    "fix": "oxlint . --fix; prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/app",
    "lint": "oxlint . && bun run lint:ui",
    "lint:ui": "oxlint -c .oxlintrc.ui.json packages/app/src/components/ui",
    "knip": "knip-bun",
    "check:workspace": "sherif",
    "check:docs": "bun tools/check-docs.ts",
    "check:env": "bun tools/env-example.ts --check",
    "env:example": "bun tools/env-example.ts",
    "format": "prettier --write .",
    "drizzle:generate": "bun run --filter '@repo/database' drizzle:generate",
    "drizzle:migrate": "bun run --filter '@repo/database' drizzle:migrate",
    "drizzle:migrate:test": "DATABASE_URL=postgresql://user:pass@localhost:5432/app_test bun run --filter '@repo/database' drizzle:migrate",
    "drizzle:check": "sh tools/check-migrations.sh",
    "drizzle:push": "bun run --filter '@repo/database' drizzle:push",
    "drizzle:studio": "bun run --filter '@repo/database' drizzle:studio",
    "test": "bun test packages/server",
    "test:e2e": "bun run --filter '@repo/e2e' test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@shadcn/lint": "^0.2.5",
    "@types/bun": "^1.4.5",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "sherif": "1.13.0",
    "typescript": "^7.0.2"
  }
}
